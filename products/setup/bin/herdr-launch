#!/bin/sh
# Starts one registered, verified Herdr worker in seven checked steps:
# tab (or given pane), taskr new, taskr launch, pane env, env check,
# herdr agent start, taskr prompt --confirm (one Enter when no receipt
# comes; the final line then ends submit_retry=enter). The first failed step
# stops the run.
# Usage: herdr-launch [--machine LABEL] [--workspace W] [--cwd DIR] [--push] [--work W] LANE NAME BRIEF REPORT PARENT [PANE]
#        herdr-launch --reserved TASK LAUNCH LANE NAME BRIEF REPORT PARENT PANE
#        herdr-launch --lanes
#        herdr-launch [--push] --check [LANE...]
# Without PANE the tab goes to W (default: the caller's workspace) with cwd
# DIR (default: pwd -P). A given PANE may be in any workspace; its workspace,
# tab, and cwd come from herdr pane get. A pane cwd containing , { } " or \
# is not supported: the run stops at step 1.
# --machine LABEL selects one enabled saved machine (claude/codex only).
# Needs target PANE or --workspace W and --cwd DIR; no --push/--reserved/--check.
# BRIEF is on the caller; REPORT is on the target.
# --push starts the lane with its taskr push adapter (launch.md "--push"):
# pi loads $HERDR_PUSH_PI_EXTENSION; claude gets a private --mcp-config and
# the taskr development channel, whose start dialog step 6 answers; codex gets a
# step 8 that runs `taskr push codex --codex-bin $HERDR_PUSH_CODEX_BIN` in its
# own tab once the session has run `taskr start`.
# --work W12 (or 12) starts the lane from PARENT's ticket W12. Before step 1
# it refuses (exit 2) a ticket that is missing, done or cancelled, lacks
# intent/acceptance/scope/dependencies, or has a dependency not done. It
# writes BRIEF's sibling <brief>.W12.md (never overwritten): BRIEF with a
# Work/Intent/Acceptance/Scope block after its three header lines, which steps
# 2 and 7 register and send. Step 2 adds `taskr set TASK work=12`; the final
# line adds work_brief=<path>. Not with --reserved.
set -u

usage='usage: herdr-launch --lanes | herdr-launch [--push] --check [LANE...] | herdr-launch [--machine LABEL] [--workspace W] [--cwd DIR] [--push] [--work W] LANE NAME BRIEF REPORT PARENT [PANE]'

herdr_bin_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) || exit 2
. "$herdr_bin_dir/herdr-lanes.sh"

# herdr agent start with the native flags of the lane's kind: full permissions,
# no sandbox, hooks
# always trusted, and no prompt or folder-trust dialog. Isolation between
# workers comes from the worktree and the brief's owned and forbidden files.
# Claude: bypass mode, no sandbox settings. Folder trust comes from
#   CLAUDE_CODE_SANDBOXED=1 (step 4), which is the trust bypass, not a
#   sandbox: Claude Code 2.1.292 reads it only to skip the trust check and
#   project-settings gating, never to turn on sandbox.enabled. Undocumented.
# Codex: --dangerously-bypass-approvals-and-sandbox; both
#   checkouts are trusted projects.
# pi: no approval prompts of its own; --approve trusts project files.
# OpenCode v2: --auto approves non-denied permissions; --standalone keeps the
# pane model/config and hook environment off the shared background server.
# The root TUI has no model/effort flags; OPENCODE_CONFIG_CONTENT selects the
# model for this process only. Lane effort is recorded but ignored.
start_agent() {
    case $kind in
        claude) set -- --model "$model" --effort "$effort" --dangerously-skip-permissions \
            --settings '{"agentPushNotifEnabled":false,"autoMemoryEnabled":false,"promptSuggestionEnabled":false,"awaySummaryEnabled":false,"idleCompaction":false,"enabledPlugins":{"posthog@claude-plugins-official":false,"cc-plugin-you-should-know@builtin":false,"slack@claude-plugins-official":false,"stripe@claude-plugins-official":false}}'
            [ -z "$push" ] || set -- "$@" --mcp-config "$mcp_config" --dangerously-load-development-channels server:taskr ;;
        codex) set -- -m "$model" -c "model_reasoning_effort=\"$effort\"" \
            --dangerously-bypass-approvals-and-sandbox \
            -c "projects={$codex_trust}" --dangerously-bypass-hook-trust ;;
        opencode) set -- --standalone --auto ;;
        pi) set -- --provider "$provider" --model "$model" --thinking "$effort" --approve
            [ -z "$push" ] || set -- "$@" --extension "$HERDR_PUSH_PI_EXTENSION" ;;
    esac
    herdr agent start "$name" --kind "$kind" --pane "$pane" --timeout 90000 -- "$@" >/dev/null
}

# trust_paths: sets codex_trust, the Codex projects table that trusts the cwd
# and, in a linked worktree, the main checkout. Fails on a path with " \ or
# a control character, which the TOML string cannot carry.
trust_paths() {
    main=
    if [ -z "$machine" ]; then
        common=$(git -C "$cwd" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || common=
    fi
    case $common in
        */.git) [ "${common%/.git}" = "$cwd" ] || main=${common%/.git} ;;
    esac
    case $cwd$main in
        *[\"\\]* | *[[:cntrl:]]*) return 1 ;;
    esac
    codex_trust="\"$cwd\"={trust_level=\"trusted\"}"
    [ -z "$main" ] || codex_trust="$codex_trust,\"$main\"={trust_level=\"trusted\"}"
}

die() {
    printf 'herdr-launch: %s\n' "$1" >&2
    exit 2
}

workspace= tab= pane= task= launch= push_tab= mcp_config= reserved_setup_file= work_brief=
step_fail() {
    printf 'herdr-launch: step %s failed; so far: workspace=%s task=%s launch=%s tab=%s pane=%s%s%s%s\n' \
        "$1" "${workspace:--}" "${task:--}" "${launch:--}" "${tab:--}" "${pane:--}" \
        "${push_tab:+ push_tab=$push_tab}" "${mcp_config:+ mcp_config=$mcp_config}" \
        "${work_brief:+ work_brief=$work_brief}" >&2
    [ -z "$reserved_setup_file" ] || printf 'herdr-launch: setup artifact=%s; inspect before retry\n' "$reserved_setup_file" >&2
    exit 1
}

# json_str KEY JSON: the one distinct value of "KEY":"..." in JSON; fails
# when it is missing or has two values.
json_str() {
    json_val=$(printf '%s\n' "$2" | tr ',{}' '\n\n\n' \
        | sed -n "s/^ *\"$1\": *\"\\([^\"]*\\)\" *\$/\\1/p" | sort -u)
    [ -n "$json_val" ] && [ "$(printf '%s\n' "$json_val" | wc -l)" -eq 1 ] \
        && printf '%s\n' "$json_val"
}

# key_once KEY JSON: the raw text "KEY": occurs exactly once in JSON, counted
# before any splitting, so a nested key of the same name (pane get's tokens
# map) cannot stand in for one the reader could not read.
key_once() {
    [ "$(printf '%s\n' "$2" | awk -v k="\"$1\"" '{ n += gsub(k "[ ]*:", "") } END { print n + 0 }')" -eq 1 ]
}

json_num() {
    json_val=$(printf '%s\n' "$2" | tr ',{}' '\n\n\n' \
        | sed -n "s/^ *\"$1\": *\\([0-9][0-9]*\\) *\$/\\1/p" | sort -u)
    [ -n "$json_val" ] && [ "$(printf '%s\n' "$json_val" | wc -l)" -eq 1 ] \
        && printf '%s\n' "$json_val"
}

# OpenCode's installer may leave its bin directory off PATH.
resolve_cli() {
    cli=$(command -v "$kind") && return 0
    [ "$kind" = opencode ] && [ -x "$HOME/.opencode/bin/opencode" ] || return 1
    cli=$HOME/.opencode/bin/opencode
}

# Preflight never calls herdr or taskr, and hides harness version output.
check_lanes() {
    lane_table_load || return 2
    [ $# -gt 0 ] || set -- $(printf '%s\n' "$lane_data" | jq -r 'keys[]')
    check_status=0
    for checked_lane do
        reason=
        if ! lane_info "$checked_lane" 2>/dev/null; then
            reason=$(printf '%s\n' "$lane_data" | jq -r --arg lane "$checked_lane" '
                if has($lane) then "denied: " + (.[$lane].denied | join(", ")) else "unknown lane" end')
        elif [ -n "$push" ] && [ "$kind" = opencode ]; then
            reason='--push is not supported for opencode; use pane prompts'
        elif ! resolve_cli; then
            reason="missing CLI: $kind"
        elif ! "$cli" --version >/dev/null 2>&1; then
            reason="$kind --version failed"
        elif { [ "$kind" = claude ] || [ "$kind" = codex ]; } && [ -x "$HOME/.local/bin/codator" ] &&
            ! "$HOME/.local/bin/codator" "$kind" --version >/dev/null 2>&1; then
            reason="Codator $kind --version failed"
        elif [ -n "$push" ]; then
            case $kind in
                pi) [ -f "${HERDR_PUSH_PI_EXTENSION-}" ] || reason='missing HERDR_PUSH_PI_EXTENSION' ;;
                codex)
                    case ${HERDR_PUSH_CODEX_BIN-} in
                        *[\'\"\\]* | *[[:cntrl:]]*) reason='invalid HERDR_PUSH_CODEX_BIN' ;;
                        /*) [ -f "$HERDR_PUSH_CODEX_BIN" ] && [ -x "$HERDR_PUSH_CODEX_BIN" ] &&
                            "$HERDR_PUSH_CODEX_BIN" --version >/dev/null 2>&1 || reason='HERDR_PUSH_CODEX_BIN --version failed' ;;
                        *) reason='missing absolute HERDR_PUSH_CODEX_BIN' ;;
                    esac ;;
            esac
        fi
        printf '%s: %s\n' "$checked_lane" "${reason:-ok}"
        [ -z "$reason" ] || check_status=1
    done
    return "$check_status"
}

workspace= cwd= push= reserved_task= reserved_launch= work_id= machine= machine_host= check=
while :; do
    case ${1-} in
        --lanes)
            [ $# -eq 1 ] || die "$usage"
            lane_list || exit 2
            exit 0
            ;;
        --check)
            check=1
            shift
            break
            ;;
        --machine)
            [ -z "$machine" ] && [ -n "${2-}" ] || die '--machine needs LABEL once'
            machine=$2
            shift 2
            ;;
        --workspace)
            [ -n "${2-}" ] || die "--workspace needs a workspace id; $usage"
            workspace=$2
            shift 2
            ;;
        --cwd)
            [ -n "${2-}" ] || die "--cwd needs a directory; $usage"
            cwd=$2
            shift 2
            ;;
        --push)
            push=1
            shift
            ;;
        --reserved)
            [ -z "$reserved_task" ] && [ $# -ge 3 ] || die '--reserved needs TASK LAUNCH once'
            reserved_task=$2 reserved_launch=$3
            case $reserved_task:$reserved_launch in
                *[!0-9:]* | :* | *: | 0:* | *:0) die 'reserved identities must be positive integers' ;;
            esac
            shift 3
            ;;
        --work)
            [ -z "$work_id" ] && [ -n "${2-}" ] || die '--work needs W<id> or <id> once'
            work_id=${2#W}
            case $work_id in
                '' | *[!0-9]* | 0*) die "--work '$2' is not W<id> or <id>" ;;
            esac
            shift 2
            ;;
        *) break ;;
    esac
done
if [ -n "$check" ]; then
    [ -z "$machine" ] || die '--machine does not combine with --check'
    for checked_arg do
        [ "$checked_arg" != --machine ] || die '--machine does not combine with --check'
    done
fi
if [ -n "$machine" ]; then
    [ -z "$push" ] || die '--machine does not combine with --push'
    [ -z "$reserved_task" ] || die '--machine does not combine with --reserved'
    case $cwd in '' | /*) ;; *) die '--machine needs an absolute --cwd' ;; esac
else
    cwd_arg=$cwd
    [ -z "$cwd_arg" ] || cwd=$(CDPATH= cd -- "$cwd_arg" 2>/dev/null && pwd -P) || die "--cwd '$cwd_arg' is not a directory"
fi
if [ -n "$check" ]; then
    check_lanes "$@"
    exit $?
fi
[ -z "$work_id" ] || [ -z "$reserved_task" ] || die '--work does not combine with --reserved'
[ $# -eq 5 ] || [ $# -eq 6 ] || die "$usage"
lane=$1 name=$2 brief=$3 report=$4 parent=$5 given_pane=${6-}
[ -z "$reserved_task" ] || [ -n "$given_pane" ] || die '--reserved requires PANE'

lane_info "$lane" || die "unknown lane '$lane'"
if [ -n "$machine" ]; then
    case $kind in claude | codex) ;; *) die '--machine supports claude and codex only' ;; esac
    [ -n "$given_pane" ] || { [ -n "$workspace" ] && [ -n "$cwd" ]; } \
        || die '--machine needs PANE or both --workspace and --cwd'
fi
case $name in
    [a-z]*-?*) ;;
    *) die "name '$name' must be PREFIX-SLUG and match [a-z][a-z0-9_-]{0,31}" ;;
esac
case $name in
    *[!a-z0-9_-]*) die "name '$name' must match [a-z][a-z0-9_-]{0,31}" ;;
esac
[ "${#name}" -le 32 ] || die "name '$name' is longer than 32 characters"
prefix=${name%%-*}
case $prefix in
    impl | mech | glm) role=implementer ;;
    rs | arch | gather) role=researcher ;;
    rev) role=reviewer ;;
    orch) role=sub-orchestrator ;;
    *) die "name prefix '$prefix-' is not impl-, mech-, rs-, rev-, arch-, glm-, orch-, or gather-" ;;
esac
case " $prefixes " in
    *" $prefix "*) ;;
    *) prefix_lanes=$(printf '%s\n' "$lane_data" | jq -r --arg prefix "$prefix" '
           to_entries | map(select((.value.denied | length) == 0) | select(.value.prefixes | index($prefix)) | .key) | sort | join(" ")
       ')
       die "lane $lane does not launch as $prefix- (allowed: $prefixes; $prefix- lanes: $prefix_lanes)" ;;
esac
[ -f "$brief" ] || die "brief '$brief' does not exist"
brief_role=$(sed -n '1s/^HERDR-BRIEF role=\([^[:space:]]*\).*$/\1/p' "$brief")
case $brief_role in
    orchestrator | sub-orchestrator | implementer | mechanical-worker | researcher | code-reviewer | reviewer | architect | code-validator) ;;
    *) die 'brief first line must start with HERDR-BRIEF role=<supported role>' ;;
esac
case $role:$brief_role in
    implementer:implementer | implementer:mechanical-worker | researcher:researcher | researcher:architect \
    | reviewer:code-reviewer | reviewer:reviewer | reviewer:code-validator | sub-orchestrator:sub-orchestrator) ;;
    *) die "brief role=$brief_role is not allowed for prefix=$prefix-" ;;
esac
brief_report=$(grep -m 1 -E '^(orchestrator=.*[[:blank:]])?report=' "$brief") \
    || die 'brief needs the report= header'
brief_report=${brief_report%"$(printf '\r')"}
brief_report=${brief_report#*report=}
brief_report=${brief_report%%[[:blank:]]*}
[ "$brief_report" = "$report" ] || die "brief report=$brief_report, REPORT=$report: report paths must match"
for field in 'Task topology:' 'Objective:' 'Acceptance:' 'Validation:'; do
    grep -q "^$field" "$brief" || die "brief needs the $field header"
done
if [ "$role" = implementer ]; then
    grep -q '^Ownership:' "$brief" || die 'brief needs the Ownership: header'
fi
case $report in
    /*) ;;
    *) die "report '$report' is not an absolute path" ;;
esac
case $parent in
    '' | *[!0-9]*) die "parent '$parent' is not a task id" ;;
esac
case ${6+set} in
    set)
        [ -n "$given_pane" ] || die 'PANE is empty'
        [ -z "$workspace" ] || die '--workspace applies only without PANE; the pane names its own workspace'
        [ -z "$cwd" ] || die '--cwd applies only without PANE; the pane names its own cwd'
        ;;
esac
if [ -n "$push" ]; then
    case $kind in
        opencode) die '--push is not supported for opencode; use pane prompts' ;;
        pi)
            [ -f "${HERDR_PUSH_PI_EXTENSION-}" ] \
                || die "--push for pi needs HERDR_PUSH_PI_EXTENSION naming taskr's adapters/pi/taskr-push.ts"
            ;;
        codex)
            case ${HERDR_PUSH_CODEX_BIN-} in
                *[\'\"\\]* | *[[:cntrl:]]*) die 'HERDR_PUSH_CODEX_BIN must not contain quote characters, a backslash, or a control character' ;;
                /*) ;;
                *) die '--push for codex needs HERDR_PUSH_CODEX_BIN as an absolute path to the real Codex CLI' ;;
            esac
            [ -f "$HERDR_PUSH_CODEX_BIN" ] && [ -x "$HERDR_PUSH_CODEX_BIN" ] \
                || die "HERDR_PUSH_CODEX_BIN '$HERDR_PUSH_CODEX_BIN' is not an executable file"
            grep -q -F 'taskr start' "$brief" \
                || die "--push for codex needs 'taskr start' in the brief: the push sidecar waits for the launch's thread and home registration"
            ;;
    esac
fi

# A worker may gather facts under its own task; it may not launch other lanes.
if [ -n "${TASKR_TASK:-}" ]; then
    caller_rows=$(taskr --json status --tree "$TASKR_TASK" --all) || die 'could not read caller task and children'
    caller=$(printf '%s\n' "$caller_rows" | jq -ces --arg id "$TASKR_TASK" '
        [.[] | select((.id | tostring) == $id)] | select(length == 1) | .[0] |
        select((.role | type) == "string" and (.name | type) == "string" and (.name | length) > 0)') \
        || die 'could not read caller role and name'
    caller_role=$(printf '%s\n' "$caller" | jq -r .role)
    case $caller_role in
        orchestrator | sub-orchestrator) ;;
        reviewer | researcher)
            [ -z "$reserved_task" ] && [ -z "$machine" ] || die 'a lane cannot use --reserved or --machine'
            [ -z "$given_pane" ] && [ -z "$workspace" ] || die 'a gather helper uses a new tab in the caller workspace'
            [ "$prefix" = gather ] || die 'a reviewer or researcher may launch only gather- helpers'
            [ "$parent" = "$TASKR_TASK" ] || die 'a gather helper must use PARENT=$TASKR_TASK'
            caller_name=$(printf '%s\n' "$caller" | jq -r .name)
            case $caller_name in gather-*) die 'a gather helper cannot start a helper' ;; esac
            open_children=$(printf '%s\n' "$caller_rows" | jq -es --arg id "$TASKR_TASK" '
                [.[] | select((.parent_id | tostring) == $id and .status != "closed")] | length') \
                || die 'could not read caller children'
            [ "$open_children" -lt 3 ] || die 'a reviewer or researcher may have at most 3 open gather helpers'
            caller_docs=$(taskr --json doc ls "$TASKR_TASK" --kind brief --limit 0) || die 'could not read caller brief record'
            caller_brief_id=$(printf '%s\n' "$caller_docs" | jq -ers --arg id "$TASKR_TASK" '
                [.[] | select((.task_id | tostring) == $id and .kind == "brief" and .name == "")] |
                select(length == 1) | .[0] | select(.captured == true) | .doc_id | numbers') \
                || die 'could not read captured caller brief id'
            caller_brief=$(taskr doc get "$caller_brief_id") || die 'could not read captured caller brief'
            gather_rule=$(printf '%s\n' "$caller_brief" | tr -d '\r' | grep -Ei '^[[:blank:]-]*Gather helpers[[:blank:]]*:[[:blank:]]*none([^[:alnum:]]|$)')
            gather_rule_status=$?
            [ "$gather_rule_status" -le 1 ] || die 'could not read caller brief'
            [ -z "$gather_rule" ] || die 'caller brief says Gather helpers: none'
            ;;
        *) die "caller role=$caller_role cannot start helpers" ;;
    esac
fi

# Fail before creating a tab or a task when OpenCode is absent.
if [ "$kind" = opencode ]; then
    resolve_cli || die 'missing CLI: opencode (also checked ~/.opencode/bin/opencode)'
    opencode_cli=$(jq -nr --arg path "$cli" '$path | @sh') || exit 2
    opencode_config=$(jq -cn --arg model "$model" \
        '{model:$model,default_agent:"build",agents:{build:{model:$model}}}' | jq -Rr @sh) || exit 2
fi

# Discovery is local; all pane and agent operations use the saved machine.
if [ -n "$machine" ]; then
    machines=$(command herdr machine list --json) || die 'could not list saved machines'
    machine_host=$(printf '%s\n' "$machines" | jq -er --arg label "$machine" '
        def host: .target | strings | split("@")[-1] | ascii_downcase |
            select((contains(":") or test("^[0-9]+(\\.[0-9]+){3}$")) | not) |
            split(".")[0] | select(test("^[a-z0-9][a-z0-9-]*$"));
        . as $machines |
        [.[] | select(.enabled == true and (.label == $label or .id == $label))] |
        (if length != 1 then error("need one enabled machine") else .[0] | host end) as $host |
        [$machines[] | select(.enabled == true) | select(host == $host)] |
        if length == 1 then $host
        else error("host \($host) matches \(length) enabled machines; exactly one is required") end') \
        || die "machine '$machine' needs one enabled saved label or id with a hostname target"
    herdr() { command herdr --machine "$machine" "$@"; }
fi

# Compact output is what the parsers below read.
unset TASKR_FORMAT

# --work: PARENT's tickets as `taskr --json work list` prints them (.work[]
# entries from show(), taskr-core/src/store/work/mod.rs:402-437). The ticket's
# spec is the contract of its current revision.
if [ -n "$work_id" ]; then
    tickets=$(taskr --json work list "$parent") || die "W$work_id: taskr work list $parent failed"
    refusal=$(printf '%s\n' "$tickets" | jq -r --argjson id "$work_id" --argjson root "$parent" '
        def spec: . as $w | [$w.revisions[]? | select(.revision == $w.revision) | .contract][0];
        def nonempty: (type == "string" or type == "array") and length > 0;
        (.work // []) as $all | [$all[] | select(.work_id == $id and .campaign == $root)][0] as $w |
        if $w == null then "W\($id) is not a ticket in campaign \($root)"
        elif $w.state == "done" or $w.state == "cancelled" then "W\($id) is \($w.state)"
        else ($w | spec) as $c |
            [if ($c.intent | type) == "string" and ($c.intent | length) > 0 then empty else "intent" end,
             if $c.acceptance | nonempty then empty else "acceptance" end,
             if ($c.scope | type) == "array" then empty else "scope" end,
             if ($c.dependencies | type) == "array" then empty else "dependencies" end] as $missing |
            if $missing != [] then "W\($id) spec lacks \($missing | join(", "))"
            else first($c.dependencies[] | (.work? // .) as $d | [$all[] | select(.work_id == $d)][0] as $dw |
                    select($dw.state != "done" and $dw.state != "accepted") |
                    "W\($id) depends on W\($d), which is \($dw.state // "not in campaign \($root)")") // empty
            end
        end') || die "W$work_id: unreadable taskr work list $parent"
    [ -z "$refusal" ] || die "$refusal"
    work_brief=${brief%.md}.W$work_id.md
    [ ! -e "$work_brief" ] && [ ! -L "$work_brief" ] || die "work brief '$work_brief' already exists"
    # The ticket block goes after the brief's three header lines; newlines in
    # one-line fields become spaces so they cannot add header lines.
    (set -C; {
        sed -n '1,3p' "$brief" &&
        printf '%s\n' "$tickets" | jq -r --argjson id "$work_id" '
            def line: tostring | gsub("[\r\n]+"; " ");
            .work[] | select(.work_id == $id) | . as $w |
            [$w.revisions[] | select(.revision == $w.revision) | .contract][0] as $c |
            "Work: W\($id) \($w.title | line)", "Intent: \($c.intent | line)", "Acceptance:",
            (if ($c.acceptance | type) == "array" then $c.acceptance[] | line
             else $c.acceptance | split("\n")[] | select(length > 0) end | "- \(.)"),
            "Scope: \(if $c.scope == [] then "none (read-only)" else $c.scope | map(line) | join(", ") end)"' &&
        sed '1,3d' "$brief"
    } >"$work_brief") || die "could not write work brief '$work_brief'"
    brief=$work_brief
fi

# Reserved starts are controller-owned. Connect before any Herdr CLI, whose
# ordinary missing-server path may auto-start a server. Failure is closed.
reserved_check() {
    lane_info "$lane" || return 1
    case " $prefixes " in *" $prefix "*) ;; *) return 1 ;; esac
    snapshot=$(taskr --json work list "$parent") || return 1
    printf '%s\n' "$snapshot" | jq -e --argjson task "$reserved_task" \
        --argjson launch "$reserved_launch" --arg pane "$pane" --arg ws "$workspace" \
        --arg tab "$tab" --arg cwd "$cwd" --arg lane "$lane" --arg kind "$kind" \
        --arg model "$model" --arg effort "$effort" --arg role "$role" \
        --argjson generation "$reserved_generation" --argjson root "$parent" '
        . as $s | .campaign == $root and .configuration.enabled == true and .parked == false and .generation == $generation and
        ([.work[] | . as $w | .runs[] | select(.run_id == $w.current_run and .state == "active") |
          . as $r | .assignments[] | select(.launch_id == $launch and .task_id == $task and .round == $r.round) |
          select(.state == "starting" and .dispatch.workspace == $ws and .dispatch.tab == $tab and .dispatch.pane == $pane) |
          select(.lane.name == $lane and .lane.provider == $kind and .lane.model == $model and .lane.effort == $effort) |
          select((.stage == "executor" and $role == "implementer") or
                 ((.stage == "reviewer" or .stage == "adjudicator") and $role == "reviewer")) |
          $w.revisions[] | select(.revision == $w.revision and .contract.checkout.cwd == $cwd)] | length == 1)' >/dev/null
}
if [ -n "$reserved_task" ]; then
    [ -z "$push" ] || die '--reserved uses the durable work controller, not a push sidecar'
    reserved_cli=${TASKR_WORK_EXECUTABLE-}
    [ -n "$reserved_cli" ] || reserved_cli=$(command -v taskr) || die 'reserved taskr CLI is missing'
    case $reserved_cli in /*/taskr) ;; *) die 'reserved taskr executable must be an absolute path named taskr' ;; esac
    [ -f "$reserved_cli" ] && [ -x "$reserved_cli" ] || die 'reserved taskr executable is not executable'
    reserved_bin=$(CDPATH= cd -- "$(dirname -- "$reserved_cli")" && pwd -P) || die 'reserved taskr directory is missing'
    reserved_path=$(jq -nr --arg path "$reserved_bin:$PATH" '$path | @sh') || die 'invalid reserved PATH'
    reserved_context=" unset TASKR_DB && export PATH=$reserved_path"
    if [ "${TASKR_DB+x}" = x ]; then
        reserved_db=$TASKR_DB
        case $reserved_db in /*) ;; *) reserved_db=$(pwd -P)/$reserved_db ;; esac
        reserved_db=$(jq -nr --arg db "$reserved_db" '$db | @sh') || die 'invalid reserved TASKR_DB'
        reserved_context="$reserved_context && export TASKR_DB=$reserved_db"
    fi
    taskr() { "$reserved_cli" "$@"; }
    reserved_server() {
        python3 - <<'PY'
import os, socket
path = os.environ.get('HERDR_SOCKET_PATH') or os.path.expanduser('~/.config/herdr/herdr.sock')
with socket.socket(socket.AF_UNIX) as conn:
    conn.settimeout(0.5)
    conn.connect(path)
PY
    }
    herdr() {
        reserved_server || return 1
        command herdr "$@"
    }
    reserved_server || step_fail '1 (reserved server unavailable; no Herdr command run)'
    agents=$(herdr agent list) || step_fail '1 (reserved server compatibility)'
    printf '%s\n' "$agents" | jq -e --arg pane "$given_pane" --arg name "$name" \
        '.result.agents | type == "array" and all(.[]; .pane_id != $pane and .name != $name)' >/dev/null \
        || step_fail '1 (reserved pane or agent name occupied)'
fi

# Step 1: a new tab in the task workspace, or the given pane.
if [ -z "$given_pane" ]; then
    [ -n "$cwd" ] || cwd=$(pwd -P)
    if [ -z "$workspace" ]; then
        current=$(herdr pane current --current) || step_fail '1 (herdr pane current)'
        workspace=$(json_str workspace_id "$current") || step_fail '1 (workspace id from herdr pane current)'
    fi
    created=$(herdr tab create --workspace "$workspace" --cwd "$cwd" --label "$name" \
        --env FLEET_ROLE=worker --env DISABLE_AUTO_UPDATE=true --no-focus) \
        || step_fail '1 (herdr tab create)'
    tab=$(json_str tab_id "$created") || step_fail '1 (tab id from herdr tab create)'
    pane=$(json_str pane_id "$created") || step_fail '1 (pane id from herdr tab create)'
else
    pane=$given_pane
    info=$(herdr pane get "$pane") || step_fail '1 (herdr pane get)'
    for key in workspace_id tab_id cwd; do
        key_once "$key" "$info" || step_fail "1 (\"$key\" is not in herdr pane get exactly once)"
    done
    workspace=$(json_str workspace_id "$info") || step_fail '1 (workspace id from herdr pane get)'
    tab=$(json_str tab_id "$info") || step_fail '1 (tab id from herdr pane get)'
    # The sed reader cannot unescape JSON, so a misread cwd must fail here.
    unread='1 (the pane cwd could not be read; paths containing ,{}"\ are not supported)'
    cwd=$(json_str cwd "$info") || step_fail "$unread"
    case $cwd in
        *\\*) step_fail "$unread" ;;
    esac
    [ -n "$machine" ] || [ -d "$cwd" ] || step_fail "$unread"
    procs=$(herdr pane process-info --pane "$pane") || step_fail '1 (herdr pane process-info)'
    fg=$(json_num foreground_process_group_id "$procs") \
        || step_fail '1 (foreground process group from herdr pane process-info)'
    shell_pid=$(json_num shell_pid "$procs") || step_fail '1 (shell pid from herdr pane process-info)'
    [ "$fg" = "$shell_pid" ] || step_fail "1 (pane $pane is not at its shell prompt)"
    if [ -z "$reserved_task" ]; then
        herdr pane send-keys "$pane" ctrl+c >/dev/null || step_fail '1 (herdr pane send-keys ctrl+c)'
    fi
fi

# Probe target facts once, before registration; the command echo cannot match
# the marker lines because printf expands the marker variable only on output.
if [ -n "$machine" ]; then
    probe_marker=herdr-launch-probe-$$-$(date +%s)
    probe_cwd=$(jq -nr --arg cwd "$cwd" '$cwd | @sh') || step_fail '1 (quote target cwd)'
    probe=" probe_marker=$probe_marker; probe_cwd=0; test -d $probe_cwd && probe_cwd=1; probe_common=\$(git -C $probe_cwd rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || probe_common=; probe_cli=\$(command -v $kind) || probe_cli=; probe_codator=0; test ! -x \"\$HOME/.local/bin/codator\" || probe_codator=1; printf '\\n'; printf '%s\\n' \"\$probe_marker\" \"\$probe_cwd\" \"\$probe_common\" \"\$probe_cli\" \"\$probe_codator\" \"\$probe_marker-end\""
    herdr pane run "$pane" "$probe" >/dev/null || step_fail '1 (target probe run)'
    herdr pane wait-output "$pane" --match "$probe_marker-end" --timeout 15000 >/dev/null \
        || step_fail '1 (target probe wait)'
    probe_screen=$(herdr pane read "$pane" --source recent-unwrapped --lines 80) \
        || step_fail '1 (target probe read)'
    probe_text=$(printf '%s\n' "$probe_screen" | jq -r '.. | strings' 2>/dev/null) || probe_text=$probe_screen
    facts=$(printf '%s\n' "$probe_text" | tr -d '\r' | awk -v marker="$probe_marker" '
        $0 == marker { inside=1 }
        inside { print }
        $0 == marker "-end" { inside=0 }' | jq -Rs --arg marker "$probe_marker" 'split("\n") | .[:-1] |
        select(length == 6 and .[0] == $marker and .[5] == ($marker + "-end")) | .[1:5] |
        select(.[0] == "1" and (.[2] | length > 0) and (.[3] == "0" or .[3] == "1"))') \
        || step_fail '1 (target probe unreadable)'
    [ -n "$facts" ] || step_fail '1 (target cwd or CLI missing, or probe unreadable)'
    common=$(printf '%s\n' "$facts" | jq -r '.[1]')
    codator=$(printf '%s\n' "$facts" | jq -r '.[3]')
else
    codator=0
    [ ! -x "$HOME/.local/bin/codator" ] || codator=1
fi

# Codex trust needs the cwd, so a path it cannot carry stops before taskr new.
[ "$kind" != codex ] || trust_paths \
    || step_fail "1 (cwd '$cwd' or its main checkout contains \" \\ or a control character)"

if [ -n "$reserved_task" ]; then
    physical_cwd=$(CDPATH= cd -- "$cwd" && pwd -P) || step_fail '2 (reserved checkout physical path unavailable)'
    [ "$physical_cwd" = "$cwd" ] || step_fail '2 (reserved checkout must use canonical physical spelling)'
    task=$reserved_task launch=$reserved_launch
    snapshot=$(taskr --json work list "$parent") || step_fail '2 (reserved campaign snapshot)'
    reserved_generation=$(printf '%s\n' "$snapshot" | jq -er '.generation | numbers') || step_fail '2 (reserved generation)'
    reserved_check || step_fail '2 (reserved task/launch/root/cwd/pane/lane mismatch)'
else
# Step 2: register. Compact output is "n1 <task>"; read the id at line end.
set --
[ -z "$machine" ] || set -- --machine "$machine_host"
out=$(taskr new "$name" --parent "$parent" --role "$role" --workspace "$workspace" \
    --tab "$tab" --pane "$pane" --cwd "$cwd" --brief "$brief" --report "$report" "$@") \
    || step_fail '2 (taskr new)'
task=$(printf '%s\n' "$out" | sed -n 's/^n1 \([0-9][0-9]*\)$/\1/p')
case $task in
    '' | *[!0-9]*) task=; step_fail "2 (no single 'n1 <task>' line in: $out)" ;;
esac
[ -z "$work_id" ] || taskr set "$task" "work=$work_id" >/dev/null \
    || step_fail "2 (taskr set $task work=$work_id)"

# Step 3: launch. Compact output is 'l1 {"launch_id":<launch>,...}'.
out=$(taskr launch "$task" --provider "$kind" --model "$model" --effort "$effort" "$@") \
    || step_fail '3 (taskr launch)'
launch=$(printf '%s\n' "$out" | sed -n 's/^l1 .*[{,]"launch_id":\([0-9][0-9]*\)[,}].*$/\1/p')
case $launch in
    '' | *[!0-9]*) launch=; step_fail "3 (no single '\"launch_id\":<id>' in: $out)" ;;
esac
fi

# Step 4: export the ids, and forward codex/claude to Codator when it exists.
# The parts are chained with && and end by setting herdr_launch_ok to the
# launch id, so step 5 sees it only when every part succeeded.
# Claude gets folder trust (see start_agent) and disables the advisor tool.
# A pi lane first drops a pi() bwrap wrapper that a reused shell kept from
# the earlier sandbox rule; ";" because zsh's unset -f fails when it is absent.
setup=" export FLEET_ROLE=worker TASKR_TASK=$task TASKR_LAUNCH=$launch"
[ -z "$reserved_task" ] || setup="$setup DISABLE_AUTO_UPDATE=true"
[ -z "$reserved_task" ] || setup="$reserved_context &&$setup"
[ "$kind" != pi ] || setup=" unset -f pi 2>/dev/null;$setup"
[ "$kind" != claude ] || setup="$setup CLAUDE_CODE_SANDBOXED=1 CLAUDE_CODE_DISABLE_ADVISOR_TOOL=1"
if [ "$codator" = 1 ]; then
    setup="$setup && codex() { \"\$HOME/.local/bin/codator\" codex \"\$@\"; } && claude() { \"\$HOME/.local/bin/codator\" claude \"\$@\"; }"
fi
if [ "$kind" = opencode ]; then
    setup="$setup && opencode() { $opencode_cli \"\$@\"; } && export OPENCODE_CONFIG_CONTENT=$opencode_config"
fi
setup="$setup && herdr_launch_ok=$launch"
setup_command=$setup
if [ -n "$reserved_task" ]; then
    # Keep long inherited PATH/config text off the interactive terminal input line.
    setup_base=$(CDPATH= cd -- "${TMPDIR:-/tmp}" && pwd -P) || step_fail '4 (private setup base unavailable)'
    case $setup_base/ in "$cwd/"*) step_fail '4 (private setup must be outside checkout)' ;; esac
    setup_dir=$(umask 077; mktemp -d "$setup_base/herdr-launch-setup.XXXXXX") \
        || step_fail '4 (create private setup directory)'
    reserved_setup_file=$setup_dir/setup.sh
    chmod 0700 "$setup_dir" || step_fail '4 (protect setup directory)'
    (umask 077; set -C; printf '%s\n' "$setup" >"$reserved_setup_file") \
        || step_fail '4 (write private setup)'
    chmod 0600 "$reserved_setup_file" || step_fail '4 (protect setup file)'
    case $reserved_setup_file in *[[:cntrl:]]*) step_fail '4 (unsupported setup path)' ;; esac
    setup_command=$(jq -nr --arg path "$reserved_setup_file" '". " + ($path | @sh)') \
        || step_fail '4 (quote private setup path)'
    [ "$(printf '%s' "$setup_command" | wc -c)" -le 512 ] \
        || step_fail '4 (private setup invocation exceeds 512 bytes)'
fi
# A failed/unknown delivery retains the file; never retry the source command here.
herdr pane run "$pane" "$setup_command" >/dev/null || step_fail '4 (herdr pane run export)'

# Step 5: prove the whole setup landed. The command text holds no expanded
# values, so only the shell's output can match.
herdr pane run "$pane" 'echo "herdr-launch-env=$TASKR_TASK/$TASKR_LAUNCH/$FLEET_ROLE/$herdr_launch_ok"' >/dev/null \
    || step_fail '5 (herdr pane run env check)'
herdr pane wait-output "$pane" --match "herdr-launch-env=$task/$launch/worker/$launch" --timeout 15000 >/dev/null \
    || step_fail "5 (the pane shell did not echo herdr-launch-env=$task/$launch/worker/$launch)"
if [ -n "$reserved_setup_file" ]; then
    rm -- "$reserved_setup_file" && rmdir -- "$setup_dir" || step_fail '5 (confirmed setup cleanup)'
    reserved_setup_file=
fi

# Step 6: start the agent with the lane's native flags. A claude --push lane
# first writes a private, task-specific config without inspecting the cwd's
# project config. A no-clobber rename publishes it at 0600. Its
# development-channel flag shows a dialog at every
# start, so agent start fails with agent_not_ready; Enter picks the first
# option, "I am using this for local development".
if [ -n "$push" ] && [ "$kind" = claude ]; then
    state_dir=$HOME/.local/state/herdr-orch/lane-push
    mcp_config=$state_dir/taskr-mcp-$task.json
    umask 077
    mkdir -p -- "$state_dir" || step_fail '6 (create push config directory)'
    chmod 0700 "$state_dir" || step_fail '6 (protect push config directory)'
    [ ! -e "$mcp_config" ] && [ ! -L "$mcp_config" ] || step_fail '6 (push config path already exists)'
    mcp_tmp=$(mktemp "$state_dir/.mcp.XXXXXX") || step_fail '6 (create push config temporary file)'
    trap '[ -z "$mcp_tmp" ] || rm -f -- "$mcp_tmp"' 0
    printf '%s\n' '{"mcpServers":{"taskr":{"command":"taskr","args":["mcp","--channel"]}}}' >"$mcp_tmp" \
        || step_fail '6 (write push config)'
    chmod 0600 "$mcp_tmp" || step_fail '6 (protect push config)'
    mv -n -- "$mcp_tmp" "$mcp_config" && [ ! -e "$mcp_tmp" ] \
        || step_fail '6 (push config exists or could not be saved)'
    mcp_tmp=
fi
[ -z "$reserved_task" ] || reserved_check || step_fail '6 (reserved decision expired)'
if ! start_agent; then
    [ -n "$push" ] && [ "$kind" = claude ] || step_fail '6 (herdr agent start)'
    screen=$(herdr pane read "$pane" --source visible --lines 40) \
        || step_fail '6 (herdr agent start, then herdr pane read)'
    case $screen in
        *'Loading development channels'*) ;;
        *) step_fail '6 (herdr agent start failed and the pane shows no development-channel dialog)' ;;
    esac
    herdr pane send-keys "$pane" Enter >/dev/null || step_fail '6 (herdr pane send-keys Enter at the development-channel dialog)'
    herdr agent wait "$name" --until idle --timeout 90000 >/dev/null \
        || step_fail '6 (the agent was not idle within 90 s after the development-channel dialog)'
fi

# Pin the actual native identity before a reserved worker can finish its brief.
if [ -n "$reserved_task" ]; then
    initialized_native=
    if [ "$kind" = codex ]; then
        initialized=$(TASKR_WORK_EXECUTABLE="$reserved_cli" "$herdr_bin_dir/herdr-codex-identity" \
            "$task" "$launch" "$parent" "$reserved_generation" "$name" "$pane" "$cwd") \
            || step_fail '6 (reserved Codex native initialization; prompt withheld)'
        initialized_native=$(printf '%s\n' "$initialized" | jq -er '
            select(.provenance_path | type == "string" and startswith("/")) |
            .native_session | select(type == "string" and length > 0)') \
            || step_fail '6 (reserved Codex initialization unconfirmed; prompt withheld)'
    fi
    agents=$(herdr agent list) || step_fail '6 (reserved native identity lookup)'
    native=$(printf '%s\n' "$agents" | jq -er --arg pane "$pane" --arg name "$name" '
        [.result.agents[] | select(.pane_id == $pane or .name == $name)] |
        select(length == 1) | .[0] | select(.pane_id == $pane and .name == $name) |
        .agent_session.value | select(type == "string" and length > 0 and utf8bytelength <= 256 and (test("[\\x00-\\x1f\\x7f]") | not))') \
        || step_fail '6 (reserved native identity missing or conflicting; prompt withheld)'
    [ -z "$initialized_native" ] || [ "$native" = "$initialized_native" ] \
        || step_fail '6 (reserved Codex initialized identity changed; prompt withheld)'
    [ "$kind" != codex ] || reserved_check || step_fail '6 (reserved decision changed before observation)'
    observed_at=$(date -u '+%Y-%m-%dT%H:%M:%SZ') || step_fail '6 (reserved observation time)'
    observation=$(jq -cn --arg pane "$pane" --arg native "$native" --arg at "$observed_at" \
        '{pane:$pane,native_session:$native,observed_at:$at}') || step_fail '6 (reserved observation JSON)'
    observed=$(taskr --json work observe "$launch" --as "$parent" --generation "$reserved_generation" --data "$observation") \
        || step_fail '6 (reserved native observation rejected; prompt withheld)'
    printf '%s\n' "$observed" | jq -e --argjson launch "$launch" --argjson task "$task" --arg pane "$pane" --arg native "$native" \
        '.launch_id == $launch and .task_id == $task and .dispatch.pane == $pane and .native_session == $native' >/dev/null \
        || step_fail '6 (reserved native observation unconfirmed; prompt withheld)'
    if [ "$kind" = codex ]; then
        reserved_check || step_fail '6 (reserved decision changed after observation)'
        agents=$(herdr agent list) || step_fail '6 (reserved final native lookup)'
        printf '%s\n' "$agents" | jq -e --arg pane "$pane" --arg name "$name" --arg native "$native" '
            [.result.agents[] | select(.pane_id == $pane or .name == $name)] |
            length == 1 and (.[0] | .pane_id == $pane and .name == $name and .agent_session.value == $native)' >/dev/null \
            || step_fail '6 (reserved native identity changed after observation; prompt withheld)'
    fi
fi

# Step 7: hand over the brief and block up to 60 s for the lane's got. A
# brief pasted but never submitted leaves no receipt, so on no_receipt only
# the pane goes to stderr, Enter is pressed once, and a got from this launch
# is polled for up to 60 s more. rejected or delivery_unknown press nothing.
# The brief is never sent twice.
submit_retry=
prompt_rc=0
sent=$(taskr prompt "$task" --file "$brief" --confirm --confirm-timeout 60000) || prompt_rc=$?
if [ "$prompt_rc" -ne 0 ]; then
    case $prompt_rc:$sent in
        5:*'"k":"no_receipt"'* | 5:*'"kind":"no_receipt"'*) ;;
        *) step_fail '7 (taskr prompt)' ;;
    esac
    printf 'herdr-launch: step 7 no receipt in 60 s; pane before one Enter:\n' >&2
    herdr pane read "$pane" --source recent-unwrapped --lines 40 >&2 \
        || printf 'herdr-launch: herdr pane read failed\n' >&2
    herdr pane send-keys "$pane" Enter >/dev/null || step_fail '7 (herdr pane send-keys Enter after no receipt)'
    deadline=$(($(date +%s) + 60)) polls=0
    until taskr log "$task" --json --limit 5 \
        | jq -n -e --argjson launch "$launch" 'any(inputs; .kind == "got" and .launch_id == $launch)' >/dev/null 2>&1; do
        polls=$((polls + 1))
        [ "$polls" -lt 30 ] && [ "$(($(date +%s) + 2))" -le "$deadline" ] \
            || step_fail '7 (no receipt 60 s after one Enter; inspect the pane, never resend)'
        sleep 2
    done
    submit_retry=' submit_retry=enter'
fi

# Step 8, codex --push only: the push sidecar in its own tab. It waits up to
# 30 min for the launch's native_home, which `taskr start` in the session
# records, then becomes `taskr push codex`. The task, launch and binary are
# validated, so the single quotes hold.
extra=
if [ -n "$push" ] && [ "$kind" = codex ]; then
    created=$(herdr tab create --workspace "$workspace" --cwd "$cwd" --label "$name-push" \
        --env FLEET_ROLE=worker --env DISABLE_AUTO_UPDATE=true --no-focus) \
        || step_fail '8 (herdr tab create)'
    push_tab=$(json_str tab_id "$created") || step_fail '8 (tab id from herdr tab create)'
    push_pane=$(json_str pane_id "$created") || step_fail '8 (pane id from herdr tab create)'
    sidecar="export TASKR_TASK=$task TASKR_LAUNCH=$launch && i=0 && until taskr log $task --limit 1 | grep -q -F '\"native_home\":\"/'; do i=\$((i + 1)); if [ \$i -ge 360 ]; then echo 'herdr-launch: the session never ran taskr start; no push sidecar'; exit 1; fi; sleep 5; done && exec taskr push codex --codex-bin '$HERDR_PUSH_CODEX_BIN'"
    herdr pane run "$push_pane" "$sidecar" >/dev/null || step_fail '8 (herdr pane run push sidecar)'
    extra=" push_tab=$push_tab push_pane=$push_pane"
fi
[ -z "$mcp_config" ] || extra=" mcp_config=$mcp_config"

printf 'task=%s launch=%s tab=%s pane=%s%s%s%s%s\n' "$task" "$launch" "$tab" "$pane" "$extra" \
    "${work_brief:+ work_brief=$work_brief}" "$submit_retry" "${machine:+ machine=$machine}"
