#!/bin/sh
# Adopt the current hub pane and exec cdl with a generation-bound push channel.
set -u
usage='usage: herdr-hub ROOT [--lane opus-high] [-- CLAUDE_ARGS...] | herdr-hub --new NAME [--lane opus-high] [-- CLAUDE_ARGS...] | herdr-hub move ROOT [--lane opus-high] [--no-handover] [-- CLAUDE_ARGS...] | herdr-hub check ROOT'
root= pane= gen= mcp_config= lease=unknown check_task= step=0 mode=start
tmp= adopt_err= lock= lock_owner= guard=
cleanup() {
    # A signal must not cut a lock or guard release in half.
    trap '' 1 2 3 15
    [ -z "$tmp" ] || rm -f -- "$tmp"
    [ -z "$adopt_err" ] || rm -f -- "$adopt_err"
    [ -z "$lock" ] || release_lock
    [ -z "$guard" ] || drop_guard
    :
}
trap cleanup 0
trap 'fail interrupted' 1 2 3 15
fail() {
    failure_reason=$1
    printf 'herdr-hub: step %s failed: %s\n' "$step" "$1" >&2
    if [ "$step" -ge 3 ]; then
        printf 'ROOT=%s GEN=%s pane=%s mcp_config=%s lease=%s check_task=%s\n' \
            "$root" "${gen:--}" "$pane" "${mcp_config:--}" "$lease" "${check_task:--}" >&2
    fi
    # A concurrent adopter may be live: never let a rerun reclaim this lock.
    case $1 in *'generation conflict'*)
        if [ -n "$lock" ] && take_guard; then
            ! own_lock || printf '%s %s hold\n' "$$" "$host" >"$lock/owner"
            drop_guard
        fi ;;
    esac
    [ -z "$gen" ] || lock=
    [ "$mode" != __move-helper ] || ledger note "herdr-hub move failed: $1" --as "$root" >/dev/null 2>&1
    exit 1
}
die() { printf 'herdr-hub: %s\n' "$1" >&2; exit 2; }
number() { case $1 in '' | *[!0-9]* | 0) return 1 ;; esac; }
identifier() { case $1 in '' | *[!A-Za-z0-9:_-]*) return 1 ;; esac; }
# Root reads/adoption must not inherit the caller's worker identity. Routing stays.
ledger() ( unset TASKR_TASK TASKR_LAUNCH; taskr "$@"; )
latest_gen() {
    log=$(ledger --json log "$root" --limit 0) || return 1
    printf '%s\n' "$log" | jq -ser '[.[] | select(.kind == "adopt") | .id] | max // 0'
}
read_lease() {
    lease=unknown
    lease_json=$(ledger --json consumer show --as "$root") || return 1
    lease=$(printf '%s\n' "$lease_json" | jq -er 'if .live == true then "live" elif .live == false then "free" else error("missing live") end')
}
current_lease() {
    printf '%s\n' "$lease_json" | jq -e --argjson gen "$gen" \
        '.live == true and .session_gen == $gen and (.holder | type == "string" and startswith("mcp-channel-"))' >/dev/null
}
latest_handover() {
    log=$(ledger --json log "$root" --limit 0) || return 1
    printf '%s\n' "$log" | jq -ser '[.[] | select(.kind == "handover") | .id] | max // 0'
}
quote() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }
# start.guard serializes every change to start.lock: acquire, reclaim, release and the hold mark.
take_guard() {
    [ -z "$guard" ] || return 0
    tries=0
    until mkdir -- "$state_dir/start.guard" 2>/dev/null; do
        tries=$((tries + 1))
        [ "$tries" -le 100 ] || return 1
        sleep 0.1
    done
    guard=$state_dir/start.guard
}
# Forget the guard before removing it: an exit trap between the two must not remove a guard another start took.
drop_guard() { dropped=$guard; guard=; rmdir -- "$dropped"; }
# Take start.lock, reclaiming it only from a dead owner on this host; callers recheck the lease under it.
# The owner file's first line is "PID HOST" (or "PID HOST hold"); its second line makes this run's copy unique.
take_lock() {
    lock_dir=$state_dir/start.lock
    take_guard || fail "$state_dir/start.guard is held for 10 s; remove it only if no herdr-lead or herdr-hub start runs for root $root"
    if ! mkdir -- "$lock_dir" 2>/dev/null; then
        owner=$(sed -n 1p -- "$lock_dir/owner" 2>/dev/null) || owner=
        owner_pid=${owner%% *}
        owner_host=${owner#* }
        if ! number "$owner_pid" || [ "$owner_host" != "$host" ] || kill -0 "$owner_pid" 2>/dev/null; then
            fail "another start needs reconciliation (start.lock owner: ${owner:-not recorded})"
        fi
        rm -f -- "$lock_dir/owner" && rmdir -- "$lock_dir" && mkdir -- "$lock_dir" || fail 'reclaim start.lock'
        printf '%s: reclaimed start.lock from exited pid %s\n' "${0##*/}" "$owner_pid" >&2
    fi
    lock_owner="$$ $host
started $(date +%s)"
    printf '%s\n' "$lock_owner" >"$lock_dir/owner" || { rm -f -- "$lock_dir/owner"; rmdir -- "$lock_dir"; fail 'record start.lock owner'; }
    lock=$lock_dir
    drop_guard || fail 'release start.guard'
}
# Change start.lock only while it is still this run's: after this process exits, a rerun may reclaim and
# replace it while a detached prover of this run still finishes.
own_lock() { [ -n "$lock" ] && [ "$(cat -- "$lock/owner" 2>/dev/null)" = "$lock_owner" ]; }
release_lock() {
    take_guard || { printf '%s: start.guard is held; start.lock kept\n' "${0##*/}" >&2; return 1; }
    ! own_lock || { rm -f -- "$lock/owner"; rmdir -- "$lock"; }
    lock=
    drop_guard
}
# The development-channel confirmation dialog is visible in the pane.
dialog_shown() {
    screen=$(herdr pane read "$1" --source visible --lines 40 2>/dev/null) || return 1
    screen=$(printf '%s\n' "$screen" | jq -Rrs '(try fromjson catch .)
        | if type == "string" then .
          elif type == "object" and (.result.lines | type) == "array" and all(.result.lines[]; type == "string")
          then .result.lines | join(" ")
          else error("missing visible lines") end | gsub("[\u2500-\u257f]"; " ") | gsub("\\s+"; " ")') || return 1
    case $screen in
        *'Loading development channels'*'1. I am using this for local development'*'Enter to confirm'*) return 0 ;;
    esac
    return 1
}

[ $# -gt 0 ] || die "$usage"
# The helper's first line says whether setsid made it a process group leader, outside the caller's group.
if [ "$1" = __move-helper ]; then
    helper_group=$(ps -o pgid= -p "$$" | tr -d ' ')
    [ "$helper_group" = "$$" ] || { printf 'herdr-hub: move: helper %s is not detached (process group %s)\n' "$$" "$helper_group"; exit 1; }
    printf 'herdr-hub: move: helper %s started in its own session\n' "$$"
fi
command -v jq >/dev/null 2>&1 || die 'jq is required'
if [ "$1" = check ]; then
    [ $# -eq 2 ] || die "$usage"
    root=$2
    number "$root" || die 'ROOT must be a positive task id'
    if ! gen=$(latest_gen) || ! read_lease; then
        printf 'unknown\n'; exit 2
    fi
    if [ "$lease" = live ] && printf '%s\n' "$lease_json" | jq -e --argjson gen "$gen" '.session_gen == $gen' >/dev/null; then
        printf 'live\n'; exit 0
    fi
    printf 'stale\n'; exit 1
fi
mode=start name= lane=opus-high no_handover= session=
case $1 in
    move | __move-helper) mode=$1; shift; [ $# -gt 0 ] || die "$usage" ;;
esac
if [ "$mode" = start ] && [ "$1" = --new ]; then
    [ $# -ge 2 ] || die "$usage"
    name=$2
    case $name in '' | [!a-z]* | *[!a-z0-9_-]*) die 'NAME must match [a-z][a-z0-9_-]{0,31}' ;; esac
    [ "${#name}" -le 32 ] || die 'NAME must match [a-z][a-z0-9_-]{0,31}'
    shift 2
else
    root=$1
    number "$root" || die 'ROOT must be a positive task id'
    shift
fi
while [ $# -gt 0 ]; do
    case $1 in
        --lane) [ $# -ge 2 ] || die "$usage"; lane=$2; shift 2 ;;
        --no-handover) [ "$mode" = move ] || die "$usage"; no_handover=1; shift ;;
        --session) [ "$mode" = __move-helper ] && [ $# -ge 2 ] || die "$usage"; session=$2; shift 2 ;;
        --) shift; break ;;
        *) die "$usage" ;;
    esac
done
step=1
pane=${HERDR_PANE_ID:-} workspace=${HERDR_WORKSPACE_ID:-} tab=${HERDR_TAB_ID:-}
identifier "$pane" && identifier "$workspace" && identifier "$tab" || die 'valid HERDR_PANE_ID, HERDR_WORKSPACE_ID and HERDR_TAB_ID are required'
[ "$pane" != null ] && [ "$workspace" != null ] && [ "$tab" != null ] || die 'invalid pane location'
herdr_bin_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) || die 'resolve launcher directory'
. "$herdr_bin_dir/herdr-lanes.sh"
lane_info "$lane" || die "unknown lane '$lane'"
[ "$kind" = claude ] || die 'Claude hubs only'
case " $prefixes " in *' orch '*) ;; *) die 'hub lane must allow orch prefix' ;; esac
[ -x "$herdr_bin_dir/cdl" ] || die 'sibling cdl must be executable'
[ "$mode" = start ] || [ -x "$herdr_bin_dir/herdr-lead" ] || die 'sibling herdr-lead must be executable'
host=$(uname -n) || die 'read local host'
state_dir=$HOME/.local/state/herdr-orch/lead-push/$root
if [ "$mode" = move ]; then
    # nohup keeps the helper in this process group, which the caller may kill with this session.
    command -v setsid >/dev/null 2>&1 || fail 'herdr-hub move needs setsid to detach its helper (util-linux); nothing was stopped'
    campaign=$(ledger --json campaign "$root") || fail 'read root campaign'
    printf '%s\n' "$campaign" | jq -e --argjson root "$root" --arg pane "$pane" \
        '.root | .id == $root and .role == "orchestrator" and .status == "open" and .pane_id == $pane' >/dev/null ||
        fail 'ROOT must be an open root orchestrator recorded at this pane'
    gen=$(latest_gen) || fail 'read latest adopt'
    if [ -z "$no_handover" ]; then
        handover_id=$(latest_handover) || fail 'read latest handover'
        [ "$handover_id" -gt "$gen" ] || fail "no handover since adopt $gen: run taskr handover --as $root --note TEXT first, or pass --no-handover"
    fi
    gen=
    # The helper stops only this agent: a reused pane must not lose an unrelated one.
    agents=$(herdr agent list) || fail 'read agent list'
    session=$(printf '%s\n' "$agents" | jq -er --arg pane "$pane" \
        '[.result.agents[]? | select(.pane_id == $pane) | .agent_session.value | select(type == "string" and length > 0)] | first') ||
        fail "no agent session in $pane to stop; nothing was stopped"
    (umask 077 && mkdir -p -- "$state_dir" && chmod 0700 "$state_dir") || fail 'create state directory'
    move_log=$state_dir/hub-move-$$.log
    ( set -C; : >"$move_log" ) || fail 'move log already exists or could not be created'
    # The helper outlives this Claude session; it must not carry Claude's environment into herdr.
    for v in $(env | sed -n 's/^\(CLAUDE[A-Z0-9_]*\)=.*/\1/p'); do unset "$v"; done
    unset TASKR_TASK TASKR_LAUNCH
    setsid "$herdr_bin_dir/herdr-hub" __move-helper "$root" --lane "$lane" --session "$session" -- "$@" </dev/null >>"$move_log" 2>&1 &
    helper=$!
    # Return only once the helper has left this process group, which the caller may kill.
    tries=0
    until [ -s "$move_log" ]; do
        tries=$((tries + 1))
        [ "$tries" -le 100 ] || fail "move helper did not start within 10 s; read $move_log"
        sleep 0.1
    done
    grep -F 'started in its own session' "$move_log" >/dev/null || fail "move helper did not detach; nothing was stopped: $(cat -- "$move_log")"
    printf 'herdr-hub: move helper %s started; log %s\n' "$helper" "$move_log"
    printf 'herdr-hub: end this turn now. The helper waits for this hub to go idle, stops it, runs herdr-hub %s in pane %s and waits for its push check.\n' "$root" "$pane"
    exit 0
fi
if [ "$mode" = __move-helper ]; then
    old_gen=$(latest_gen) || fail 'read latest adopt'
    printf 'herdr-hub: move: stop the hub in %s (generation %s)\n' "$pane" "$old_gen"
    "$herdr_bin_dir/herdr-lead" stop "$root" "$pane" --session "$session" || fail 'stop the hub'
    typed="$(quote "$herdr_bin_dir/herdr-hub") $root --lane $(quote "$lane")"
    if [ $# -gt 0 ]; then
        typed="$typed --"
        for arg; do typed="$typed $(quote "$arg")"; done
    fi
    printf 'herdr-hub: move: run %s\n' "$typed"
    herdr pane run "$pane" "$typed" >/dev/null || fail 'type herdr-hub in the hub pane'
    deadline=$(($(date +%s) + 180))
    while :; do
        new_gen=$(latest_gen) || fail 'read latest adopt'
        [ "$new_gen" -le "$old_gen" ] || break
        [ "$(date +%s)" -lt "$deadline" ] || fail 'herdr-hub did not adopt within 180 s; read the hub pane'
        sleep 3
    done
    result=$state_dir/hub-check-$new_gen.result
    # Follow the prover to its end: 600 s for the lease, up to 1800 s through a backlog, and slack.
    deadline=$(($(date +%s) + 2520))
    until [ -s "$result" ]; do
        [ "$(date +%s)" -lt "$deadline" ] || fail "no push check result for generation $new_gen within 2520 s"
        sleep 5
    done
    outcome=$(cat -- "$result") || fail 'read push check result'
    [ "$outcome" = live ] || fail "push check $new_gen: $outcome"
    printf 'herdr-hub: moved %s: generation %s live\n' "$root" "$new_gen"
    exit 0
fi
if [ -z "$name" ]; then
    campaign=$(ledger --json campaign "$root") || fail 'read root campaign'
    printf '%s\n' "$campaign" | jq -e --argjson root "$root" '.root | .id == $root and .role == "orchestrator" and .status == "open"' >/dev/null || fail 'ROOT is not an open root orchestrator'
    old=$(printf '%s\n' "$campaign" | jq -r '.root.pane_id // ""') || fail 'read recorded hub pane'
    if [ -n "$old" ] && [ "$old" != "$pane" ]; then
        agents=$(herdr agent list) || fail 'read agent list'
        printf '%s\n' "$agents" | jq -e --arg old "$old" \
            '.result.agents | type == "array" and all(.[]; .pane_id != $old)' >/dev/null || fail 'recorded hub pane is occupied'
    fi
    step=2
    deadline=$(($(date +%s) + 75))
    while :; do
        read_lease || fail 'read predecessor lease'
        [ "$lease" = live ] || break
        [ "$(date +%s)" -lt "$deadline" ] || fail 'predecessor lease is still live after 75 s'
        sleep 3
    done
else
    step=3
    out=$(ledger --json new "$name" --role orchestrator --workspace "$workspace" --tab "$tab" --pane "$pane") || fail 'create root (inspect ledger before retry)'
    root=$(printf '%s\n' "$out" | jq -er '.task_id') || fail 'read root id'
    number "$root" || fail 'invalid root id'
fi
step=3
state_dir=$HOME/.local/state/herdr-orch/lead-push/$root
old_umask=$(umask)
umask 077
mkdir -p -- "$state_dir" || fail 'create state directory'
chmod 0700 "$state_dir" || fail 'protect state directory'
take_lock
# Recheck the lease under the adoption lock.
read_lease && [ "$lease" = free ] || fail 'lease changed before adopt'
tmp=$(mktemp "$state_dir/.handover.XXXXXX") || fail 'create handover temporary file'
adopt_err=$(mktemp "$state_dir/.adopt.XXXXXX") || fail 'create adopt stderr file'
ledger adopt "$root" --workspace "$workspace" --tab "$tab" --pane "$pane" >"$tmp" 2>"$adopt_err" || { cat "$adopt_err" >&2; fail 'adopt (inspect ledger before retry)'; }
gen=$(sed -n "s/^taskr adopt: task $root now at pane .*; event \([0-9][0-9]*\)$/\1/p" "$adopt_err")
number "$gen" || fail 'could not read adopt generation'
handover=$state_dir/handover-$gen.md
[ ! -e "$handover" ] && [ ! -L "$handover" ] || fail 'handover already exists'
mv -n -- "$tmp" "$handover" && [ ! -e "$tmp" ] || fail 'handover already exists or could not be saved'
tmp=
latest=$(latest_gen) || fail 'read latest adopt'
[ "$latest" = "$gen" ] || fail 'generation conflict after adopt; do not re-adopt'

step=4
mcp_config=$state_dir/taskr-mcp-$gen.json
[ ! -e "$mcp_config" ] && [ ! -L "$mcp_config" ] || fail 'generation config exists'
tmp=$(mktemp "$state_dir/.mcp.XXXXXX") || fail 'create config temporary file'
jq -nc --arg root "$root" --arg gen "$gen" \
    '{mcpServers:{taskr:{command:"taskr",args:["mcp","--channel","--as",$root,"--session",$gen]}}}' >"$tmp" || fail 'render config'
chmod 0600 "$tmp" || fail 'protect config'
mv -n -- "$tmp" "$mcp_config" && [ ! -e "$tmp" ] || fail 'generation config exists or could not be saved'
tmp=
rm -f -- "$adopt_err" || fail 'remove adopt stderr temporary file'
adopt_err=

hub_ref=$(ledger --json log "$root" --limit 0) || fail 'read hub ref'
hub_ref=$(printf '%s\n' "$hub_ref" | jq -sr '[.[] | select(.kind == "ref" and .data.key == "hub")] | max_by(.id) | .data.value // ""') || fail 'parse hub ref'
latest=$(latest_gen) || fail 'read generation before exec'
[ "$latest" = "$gen" ] || fail 'generation conflict before exec'

prove() (
    trap '' HUP
    failure_reason='prover interrupted'
    finish() {
        rc=$?
        trap - 0
        if [ "$rc" -eq 0 ]; then
            result=live
            cleanup
        else
            result="failed: $failure_reason"
            if [ -n "$check_task" ]; then
                ledger --json close "$check_task" --outcome rejected || printf 'herdr-hub: could not close failed gate %s\n' "$check_task" >&2
            fi
        fi
        printf '%s\n' "$result" >"$state_dir/hub-check-$gen.result"
        ledger note "hub push check $gen: $result" --as "$root" || printf 'herdr-hub: could not record result note\n' >&2
        exit "$rc"
    }
    trap finish 0
    trap 'fail interrupted' INT QUIT TERM
    step=5 dialog_answered=
    deadline=$(($(date +%s) + 600))
    while :; do
        kill -0 "$$" 2>/dev/null || fail 'cdl exited before the channel lease'
        if [ -z "$dialog_answered" ] && dialog_shown "$pane"; then
            herdr pane send-keys "$pane" Enter >/dev/null 2>&1 && dialog_answered=1 &&
                printf 'herdr-hub: answered the development-channel dialog\n'
        fi
        latest=$(latest_gen) || fail 'read generation while waiting for lease'
        [ "$latest" = "$gen" ] || fail 'generation conflict while waiting for lease'
        read_lease || fail 'read live-check lease'
        if current_lease; then break; fi
        [ "$(date +%s)" -lt "$deadline" ] || fail 'no current-generation MCP channel lease within 600 s'
        sleep 3
    done
    out=$(ledger --json new "hub-push-check-$gen" --parent "$root" --role gate) || fail 'create check task (inspect before retry)'
    check_task=$(printf '%s\n' "$out" | jq -er '.task_id') || fail 'read check task id'
    number "$check_task" || fail 'invalid check task id'
    out=$(ledger --json launch "$check_task" --provider shell --model none --effort none) || fail 'launch check task (inspect before retry)'
    check_launch=$(printf '%s\n' "$out" | jq -er '.launch_id') || fail 'read check launch id'
    number "$check_launch" || fail 'invalid check launch id'
    out=$(unset TASKR_TASK TASKR_LAUNCH; TASKR_TASK=$check_task TASKR_LAUNCH=$check_launch taskr --json ready "hub push check $gen" --report "$mcp_config") || fail 'send check event (inspect before retry)'
    event=$(printf '%s\n' "$out" | jq -er '.event_id') || fail 'check event not committed (queued or unknown; inspect before retry)'
    number "$event" || fail 'invalid check event id'
    # A successor drains older pushed events first; each new ack extends the wait, up to 30 min.
    inbox=$(ledger --json inbox --as "$root") || fail 'read inbox backlog'
    acked=$(printf '%s\n' "$inbox" | jq -er '.acked_event_id // 0') || fail 'read inbox backlog'
    backlog=$(printf '%s\n' "$inbox" | jq -er --argjson event "$event" '[.events[]? | select(.id < $event)] | length') || fail 'read inbox backlog'
    printf '%s: check event %s waits behind %s unacked events\n' "${0##*/}" "$event" "$backlog"
    cap=$(($(date +%s) + 1800))
    while :; do
        kill -0 "$$" 2>/dev/null || fail 'cdl exited before the ack'
        latest=$(latest_gen) || fail 'read generation during live check'
        [ "$latest" = "$gen" ] || fail 'generation conflict during live check'
        read_lease && current_lease || fail 'current-generation channel lease lost'
        deliveries=$(ledger --json delivery ls --as "$root") || fail 'read check delivery'
        inbox=$(ledger --json inbox --as "$root") || fail 'read check ack'
        if printf '%s\n' "$deliveries" | jq -e --argjson gen "$gen" --argjson event "$event" \
            '.attempts | any(.[]; .event_id == $event and .session_gen == $gen and (.received_at | type == "string" and length > 0))' >/dev/null \
            && printf '%s\n' "$inbox" | jq -e --argjson event "$event" '.acked_event_id | type == "number" and . >= $event' >/dev/null; then
            break
        fi
        now_acked=$(printf '%s\n' "$inbox" | jq -er '.acked_event_id // 0') || fail 'read check ack'
        if [ "$now_acked" -gt "$acked" ]; then
            acked=$now_acked
            later=$(($(date +%s) + 240))
            [ "$later" -le "$cap" ] || later=$cap
            [ "$later" -le "$deadline" ] || deadline=$later
        fi
        [ "$(date +%s)" -lt "$deadline" ] || fail "check event was not received and acked within 600 s (acked through $acked; backlog $backlog)"
        sleep 3
    done
    out=$(ledger --json close "$check_task" --outcome accepted) || fail 'close check task (inspect before retry)'
    printf '%s\n' "$out" | jq -e --argjson task "$check_task" '.task_id == $task and .queued != true' >/dev/null || fail 'check task close not confirmed'
)
prover_log=$state_dir/hub-check-$gen.log
( set -C; : >"$prover_log" ) || fail 'prover log already exists or could not be created'
prove </dev/null >"$prover_log" 2>&1 &
printf 'ROOT=%s GEN=%s mcp_config=%s prover_log=%s\n' "$root" "$gen" "$mcp_config" "$prover_log"
[ "$hub_ref" = on ] || printf 'To make this the hub: taskr set %s hub=on\n' "$root"
prompt="You are the hub root $root. herdr-hub adopted you at generation $gen: do not run taskr adopt. This is a push lane: no plain taskr wait or ack. Pushed events arrive as <channel source=\"taskr\" ...>; handle each with the taskr MCP tools, and ack with its fence. Read the handover at $handover. A \"hub push check $gen\" event will arrive: record it and ack it. Session timers (Claude CronCreate jobs, background loops) died with the old session: if the handover Note lists session timers to re-arm, create each again and record the new ids with a taskr note."
unset TASKR_TASK TASKR_LAUNCH
step=6
umask "$old_umask"
exec "$herdr_bin_dir/cdl" --model "$model" --effort "$effort" --mcp-config "$mcp_config" \
    --dangerously-load-development-channels server:taskr "$@" -- "$prompt"
